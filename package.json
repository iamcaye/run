{
  "name": "run",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "reprocess": "tsx --conditions=react-server scripts/reprocess.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "better-auth": "1.7.10",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "p-limit": "7.3.3",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "resend": "6.34.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-check": "4.10.2",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.14.0"
}
