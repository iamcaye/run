# Postgres (docker compose maps to 5434 to avoid clashing with a local 5432)
DATABASE_URL=postgres://run:run@localhost:5434/run
TEST_DATABASE_URL=postgres://run:run@localhost:5434/run_test

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Protects GET /api/cron/adapt-plans — generate with: openssl rand -hex 32
CRON_SECRET=change-me

# Optional: when set, password-reset emails go out via Resend; otherwise they are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Race Training <noreply@example.com>"
